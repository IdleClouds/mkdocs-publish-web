c\u5341\u4e94\u8bb2 \u6570\u5b57\u8ff7","text":""},{"location":"math-second/#_16","title":"\u7b2c\u5341\u516d\u8bb2 \u706b\u67f4\u68d2\u6e38\u620f","text":""},{"location":"math-second/#_17","title":"\u7b2c\u5341\u4e03\u8bb2 \u4e00\u7b14\u753b\u6e38\u620f","text":""},{"location":"math-second/#_18","title":"\u7b2c\u5341\u516b\u8bb2 \u6570\u9635\u56fe","text":""},{"location":"mkdocs/","title":"\u4f7f\u7528\u6280\u5de7","text":"<p>1\u3001\u5c42\u7ea7\u53ef\u901a\u8fc7\u591a\u4e2a#\u533a\u5206\uff0c\u51716\u5c42</p> <pre><code># \u4e00\u7ea7\u6807\u9898\n## \u4e8c\u7ea7\u6807\u9898\n### \u4e09\u7ea7\u6807\u9898\n#### \u56db\u7ea7\u6807\u9898\n##### \u4e94\u7ea7\u6807\u9898\n###### \u516d\u7ea7\u6807\u9898\n</code></pre> <p>2\u3001\u6298\u53e0\u5757</p> <pre><code>&lt;details&gt;\n&lt;summary&gt;\u70b9\u51fb\u5c55\u5f00\u8be6\u60c5&lt;/summary&gt;\n\u5185\u5bb9\u5199\u5728\u8fd9\u91cc\n&lt;/details&gt;\n</code></pre> <p>3\u3001\u56fe\u7247</p> <p>(1)\u3001\u8bed\u6cd5</p> <pre><code>![\u56fe\u7247\u63cf\u8ff0\u6587\u5b57](\u56fe\u7247\u76f8\u5bf9\u8def\u5f84 \"\u9f20\u6807\u60ac\u6d6e\u63d0\u793a\u6587\u5b57\")\n</code></pre> <p>(2)\u3001\u6587\u4ef6\u5939\u7ed3\u6784</p> <pre><code>docs/\n\u251c\u2500\u2500 github.md\n\u251c\u2500\u2500 quickstart.md\n\u2514\u2500\u2500 assets/        # \u7edf\u4e00\u5b58\u653e\u6240\u6709\u56fe\u7247\u8d44\u6e90\n    \u251c\u2500\u2500 github/    # github.md\u4e13\u5c5e\u914d\u56fe\n    \u2514\u2500\u2500 common/    # \u5168\u5c40\u516c\u7528\u622a\u56fe\n</code></pre> <p>\uff083\uff09\u3001\u56fe\u7247\u547d\u540d</p> <pre><code>1\u3001\u5168\u90e8\u5c0f\u5199\n2\u3001\u5355\u8bcd\u7528\u77ed\u6a2a\u7ebf-\u5206\u5272\n3\u3001\u683c\u5f0f\uff1a\u6a21\u5757-\u7528\u9014-\u5e8f\u53f7.png\n4\u3001\u540e\u7f00\u7edf\u4e00\uff1a\u4f18\u5148png(\u622a\u56fe)\uff0cjpg(\u7167\u7247)\n</code></pre> <p>4\u3001\u53d1\u5e03</p> <pre><code>\u5148\u63d0\u4ea4md\u6e90\u7801\u5230main/master\u5206\u652f\n1\u3001git add .\n2\u3001git commit -m \"docs:\u66f4\u65b0\u6587\u6863\u5185\u5bb9\"\n3\u3001git push origin main\n\u518d\u6267\u884c\u90e8\u7f72\u547d\u4ee4\n4\u3001mkdocs gh-deploy --clean\n</code></pre>"},{"location":"prism/","title":"\u4f7f\u7528\u6280\u5de7","text":""},{"location":"prism/#ioc","title":"IOC\u5bb9\u5668","text":"<p>\u5b9e\u73b0\u4f9d\u8d56\u6ce8\u5165(DIP\u7684\u6838\u5fc3\u673a\u5236,\u7528\u4e8e\u7ba1\u7406\u7ec4\u4ef6\u751f\u547d\u5468\u671f\u3001\u89e3\u8026\u670d\u52a1\u4f9d\u8d56\u5e76\u652f\u6301\u6a21\u5757\u5316\u5f00\u53d1\uff0c\u9ed8\u8ba4\u652f\u6301\u591a\u79cd\u5bb9\u5668\uff08\u5982Unity\u3001DryIoc\uff09)</p> <p>\u5bb9\u5668\u914d\u7f6e\u5165\u53e3\uff0c\u7ee7\u627fPrismApplication</p>"},{"location":"prism/#viewviewmodel","title":"view\u548cviewModel","text":"<p>1\u3001View\u6ce8\u518c\u65b9\u5f0f</p> <pre><code> containerRegistry.RegisterForNavigation&lt;SystemSettingView&gt;();\n</code></pre>"},{"location":"prism/#_2","title":"\u533a\u57df","text":"<p>\u662fShell\u6216\u8005\u7236\u89c6\u56fe\u4e0a\u9884\u7559\u7684\u4e00\u5757UI\u5360\u4f4d\u533a\u57df\uff0c\u662f\u7528\u6765\u52a8\u6001\u6302\u8f7d/\u5378\u8f7d\u4e0d\u540c\u6a21\u5757\u7684View\uff0c\u901a\u8fc7IRegionManager\u6765\u7ba1\u7406 1\u3001Xaml\u5b9a\u4e49Region</p> <pre><code>&lt;!-- Shell\u4e3b\u7a97\u53e3Xaml --&gt;\n&lt;Window xmlns:prism=\"http://prismlibrary.com/\"&gt;\n    &lt;DockPanel&gt;\n        &lt;!-- \u9876\u90e8\u83dc\u5355\u533a\u57df --&gt;\n        &lt;ContentControl DockPanel.Dock=\"Top\" prism:RegionManager.RegionName=\"MenuRegion\"/&gt;\n        &lt;!-- \u5de6\u4fa7\u5bfc\u822a\u6811\u533a\u57df --&gt;\n        &lt;ContentControl DockPanel.Dock=\"Left\" prism:RegionManager.RegionName=\"LeftNavRegion\"/&gt;\n        &lt;!-- \u4e3b\u5185\u5bb9\u533a\u57df\uff08\u6700\u5e38\u7528\uff0c\u653e\u4e1a\u52a1\u9875\u9762\uff09 --&gt;\n        &lt;ContentControl prism:RegionManager.RegionName=\"MainContentRegion\"/&gt;\n        &lt;!-- \u5e95\u90e8\u72b6\u6001\u680f --&gt;\n        &lt;ContentControl DockPanel.Dock=\"Bottom\" prism:RegionManager.RegionName=\"StatusRegion\"/&gt;\n    &lt;/DockPanel&gt;\n&lt;/Window&gt;\n</code></pre>"},{"location":"prism/#_3","title":"\u6a21\u5757\u5316","text":"<p>1\u3001\u4e24\u4e2a\u91cd\u8981\u7684\u63a5\u53e3  IContainerProvider \u89e3\u6790\u6a21\u5757 IContainerRegistry \u6ce8\u518c\u6a21\u5757  2\u3001\u5e38\u89c1\u7684\u95ee\u9898\u603b\u7ed3  (1)\u3001\u5bfc\u822a\u627e\u4e0d\u5230\u9875\u9762\uff0c\u68c0\u67e5\u6a21\u5757\u89c6\u56fe\u540d\u79f0\u6709\u6ca1\u6709\u5199\u9519  (2)\u3001</p>"},{"location":"prism/#-","title":"\u6d88\u606f\u5bf9\u8c61(\u53d1\u5e03-\u8ba2\u9605)","text":""},{"location":"prism/#_4","title":"\u5f39\u7a97\u5bf9\u8c61","text":""},{"location":"quickstart/","title":"\u5feb\u901f\u4e0a\u624b","text":"<p>fsf  \u6211\u4eec\u662f\u597d\u670b\u53cb</p>"},{"location":"wpf/","title":"\u4f7f\u7528\u6280\u5de7","text":"<p>1\u3001MVVM Light</p> <p>2\u3001Community Toolkit.Mvvm</p> <p>3\u3001Prism</p>"}]}